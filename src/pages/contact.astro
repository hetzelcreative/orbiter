---
import Layout from "../layouts/Layout.astro";
import { business } from "../data/business";
import { services } from "../data/services";
import Text from "../components/ui/Text.astro";
import Button from "../components/ui/Button.astro";
import Section from "../components/ui/Section.astro";
import PageHero from "../components/ui/PageHero.astro";
---

<Layout
  title="Contact Us"
  description={`Contact ${business.name} in ${business.address.city}, ${business.address.stateAbbr}. Call us at ${business.phoneFormatted}.`}
>
  <PageHero
    title="Contact Us"
    description="We'd love to hear from you."
  />
  <Section>
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16">
      <!-- Form -->
      <div class="bg-gray-50 rounded-2xl p-8 md:p-10">
        <Text variant="h3" color="dark" className="mb-2">Send Us a Message</Text>
        <Text variant="base" color="muted" className="mb-8">Have a question or need assistance? Fill out the form below and we'll get back to you within 24 hours.</Text>

        <form class="space-y-6" name="contact" method="POST" data-netlify="true" data-netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="first-name" class="block text-xs font-semibold uppercase tracking-widest text-gray-500 mb-2">First Name <span class="text-red-500">*</span></label>
              <input type="text" id="first-name" name="first-name" required placeholder="John" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none" />
            </div>
            <div>
              <label for="last-name" class="block text-xs font-semibold uppercase tracking-widest text-gray-500 mb-2">Last Name <span class="text-red-500">*</span></label>
              <input type="text" id="last-name" name="last-name" required placeholder="Smith" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-widest text-gray-500 mb-2">Email</label>
              <input type="email" id="email" name="email" placeholder="john@example.com" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none" />
            </div>
            <div>
              <label for="phone" class="block text-xs font-semibold uppercase tracking-widest text-gray-500 mb-2">Phone <span class="text-red-500">*</span></label>
              <input type="tel" id="phone" name="phone" required placeholder="(555) 123-4567" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="service" class="block text-xs font-semibold uppercase tracking-widest text-gray-500 mb-2">Service Interested In</label>
              <select id="service" name="service" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none bg-white text-gray-700">
                <option value="">Select a service (optional)</option>
                {services.map((s) => (
                  <option value={s.slug}>{s.name}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="contact-method" class="block text-xs font-semibold uppercase tracking-widest text-gray-500 mb-2">Preferred Contact Method <span class="text-red-500">*</span></label>
              <select id="contact-method" name="contact-method" required class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none bg-white text-gray-700">
                <option value="">Select a method</option>
                <option value="phone">Phone Call</option>
                <option value="text">Text Message</option>
                <option value="email">Email</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold uppercase tracking-widest text-gray-500 mb-2">Your Message <span class="text-red-500">*</span></label>
            <textarea id="message" name="message" rows="5" required placeholder="How can we help you? Ask a question or tell us about your needs..." class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none"></textarea>
          </div>

          <Button type="submit">Send Message</Button>
        </form>
      </div>

      <!-- Contact Info -->
      <div>
        <Text variant="h3" color="dark" className="mb-2">Get in Touch</Text>
        <Text variant="base" color="muted" className="mb-10">Whether you have a question about our services, pricing, or anything else, our team is ready to answer all your questions.</Text>

        <div class="space-y-8">
          <!-- Visit -->
          <div class="flex items-start gap-4">
            <div class="size-12 rounded-full bg-primary-100 text-primary-600 flex items-center justify-center shrink-0">
              <svg class="size-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" />
              </svg>
            </div>
            <div>
              <Text variant="base" color="dark" weight="bold">Visit Us</Text>
              <Text variant="base" color="muted">{business.address.street}</Text>
              <Text variant="base" color="muted">{business.address.city}, {business.address.stateAbbr} {business.address.zip}</Text>
            </div>
          </div>

          <!-- Call -->
          <div class="flex items-start gap-4">
            <div class="size-12 rounded-full bg-primary-100 text-primary-600 flex items-center justify-center shrink-0">
              <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </div>
            <div>
              <Text variant="base" color="dark" weight="bold">Call Us</Text>
              <a href={`tel:${business.phone}`} class="text-base text-gray-500 hover:text-primary-600 transition-colors">{business.phoneFormatted}</a>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-start gap-4">
            <div class="size-12 rounded-full bg-primary-100 text-primary-600 flex items-center justify-center shrink-0">
              <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </div>
            <div>
              <Text variant="base" color="dark" weight="bold">Email Us</Text>
              <a href={`mailto:${business.email}`} class="text-base text-gray-500 hover:text-primary-600 transition-colors">{business.email}</a>
            </div>
          </div>

          <!-- Hours -->
          <div class="flex items-start gap-4">
            <div class="size-12 rounded-full bg-primary-100 text-primary-600 flex items-center justify-center shrink-0">
              <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
            </div>
            <div>
              <Text variant="base" color="dark" weight="bold">Hours of Operation</Text>
              {Object.entries(business.hours).map(([day, time]) => (
                <Text variant="sm" color="muted" className="capitalize">{day}: {time}</Text>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>
</Layout>
