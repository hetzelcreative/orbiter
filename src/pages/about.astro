---
import Layout from "../layouts/Layout.astro";
import { business } from "../data/business";
import Text from "../components/ui/Text.astro";
---

<Layout
  title="About Us"
  description={`Learn more about ${business.name} and our commitment to serving ${business.address.city}.`}
>
  <section class="py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <Text variant="h1" color="dark" className="mb-6">About {business.name}</Text>
      <div class="space-y-4">
        <Text variant="paragraph">
          Welcome to {business.name}! We've been proudly serving {business.address.city} and the surrounding communities with dedication and expertise.
        </Text>
        <Text variant="paragraph">
          Our team is committed to providing the highest quality service to every customer. We believe in building long-term relationships based on trust, reliability, and exceptional results.
        </Text>
        <Text variant="h3" color="dark" className="mt-8 mb-4">Why Choose Us?</Text>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="text-primary-600 mt-1">&#10003;</span>
            <Text as="span">Locally owned and operated</Text>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary-600 mt-1">&#10003;</span>
            <Text as="span">Experienced and knowledgeable team</Text>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary-600 mt-1">&#10003;</span>
            <Text as="span">Committed to customer satisfaction</Text>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-primary-600 mt-1">&#10003;</span>
            <Text as="span">Competitive and transparent pricing</Text>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
