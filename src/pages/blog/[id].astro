---
import Layout from "../../layouts/Layout.astro";
import BlogPostSchema from "../../components/schema/BlogPostSchema.astro";
import { getCollection, render } from "astro:content";
import Text from "../../components/ui/Text.astro";
import Section from "../../components/ui/Section.astro";
import PageHero from "../../components/ui/PageHero.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.image}
  ogType="article"
>
  <BlogPostSchema
    slot="head"
    title={post.data.title}
    description={post.data.description}
    publishDate={post.data.pubDate}
    updatedDate={post.data.updatedDate}
    image={post.data.image}
    url={`/blog/${post.id}/`}
  />

  <PageHero title={post.data.title} />

  <Section>
    <article class="max-w-7xl mx-auto">
      {post.data.image && (
        <img
          src={post.data.image}
          alt={post.data.title}
          class="w-full rounded-xl mb-10 max-h-[500px] object-cover"
          loading="eager"
        />
      )}
      <div class="max-w-5xl mx-auto">
        <Text variant="sm" color="muted" className="mb-8">Published <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>{post.data.author && ` by ${post.data.author}`}</Text>
        <div class="prose prose-lg max-w-none">
          <Content />
        </div>
      </div>
    </article>
  </Section>
</Layout>
