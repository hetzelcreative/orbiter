---
import Layout from "../../layouts/Layout.astro";
import BlogPostSchema from "../../components/schema/BlogPostSchema.astro";
import { getCollection, render } from "astro:content";
import Text from "../../components/ui/Text.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.image}
  ogType="article"
>
  <BlogPostSchema
    slot="head"
    title={post.data.title}
    description={post.data.description}
    publishDate={post.data.pubDate}
    updatedDate={post.data.updatedDate}
    image={post.data.image}
    url={`/blog/${post.id}/`}
  />

  <article class="py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <a href="/blog/" class="text-primary-600 text-sm hover:underline mb-4 inline-block">&larr; Back to Blog</a>
      <Text variant="h1" color="dark" className="mb-3">{post.data.title}</Text>
      <div class="flex items-center gap-4 mb-8">
        <Text variant="sm" color="muted" as="span">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </time>
        </Text>
        {post.data.author && <Text variant="sm" color="muted" as="span">by {post.data.author}</Text>}
      </div>
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>
      {post.data.tags.length > 0 && (
        <div class="flex gap-2 mt-8 pt-8 border-t">
          {post.data.tags.map((tag: string) => (
            <span class="text-xs bg-primary-50 text-primary-700 px-3 py-1 rounded-full">{tag}</span>
          ))}
        </div>
      )}
    </div>
  </article>
</Layout>
