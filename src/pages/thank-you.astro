---
import Layout from "../layouts/Layout.astro";
import { business } from "../data/business";
import Button from "../components/ui/Button.astro";
import PageHero from "../components/ui/PageHero.astro";
import Section from "../components/ui/Section.astro";
import Text from "../components/ui/Text.astro";
---

<Layout
  title="Thank You"
  description={`Thanks for reaching out to ${business.name}. We'll be in touch shortly.`}
  noindex
>
  <PageHero
    title="Thanks — We Got It!"
    description="Your message is on its way. We'll be in touch soon."
  />

  <Section>
    <div class="max-w-2xl mx-auto text-center">
      <div class="inline-flex items-center justify-center size-20 rounded-full bg-primary-500 text-white mb-8">
        <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </div>

      <Text variant="h2" color="dark" align="center" className="mb-4">We'll be in touch shortly</Text>
      <Text variant="xl" color="muted" align="center" className="mb-10">
        Thanks for reaching out. We review every request personally and will get back to you as soon as we can.
      </Text>

      <div class="bg-gray-50 rounded-2xl p-6 md:p-8 mb-10 text-left">
        <Text variant="label" color="muted" className="mb-2">Need to reach us first?</Text>
        <Text variant="base" color="dark">
          <a href={`tel:${business.phone}`} class="text-primary-600 hover:text-primary-700 font-semibold">
            {business.phoneFormatted}
          </a>
          <span class="text-gray-400"> · </span>
          <a href={`mailto:${business.email}`} class="text-primary-600 hover:text-primary-700 font-semibold break-words">
            {business.email}
          </a>
        </Text>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button href="/" variant="primary">Back to Home</Button>
        <Button href="/services/" variant="outline">Browse Our Services</Button>
      </div>
    </div>
  </Section>
</Layout>
