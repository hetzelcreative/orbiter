---
import Layout from "../../layouts/Layout.astro";
import { business } from "../../data/business";
import { services, getServiceBySlug } from "../../data/services";
import { getCategoryBySlug } from "../../data/categories";
import { Image } from "astro:assets";
import Text from "../../components/ui/Text.astro";
import Button from "../../components/ui/Button.astro";
import Section from "../../components/ui/Section.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
import PageHero from "../../components/ui/PageHero.astro";
import FAQSection from "../../components/ui/FAQSection.astro";
import Breadcrumb from "../../components/layout/Breadcrumb.astro";
import ServiceSchema from "../../components/schema/ServiceSchema.astro";
import imgCta from "../../assets/Resized_20240725_103324_1721921613656.JPEG";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { category: service.category, service: service.slug },
  }));
}

const { service: serviceSlug } = Astro.params;
const service = getServiceBySlug(serviceSlug!)!;
const category = getCategoryBySlug(service.category)!;
const categoryPath = `/${category.slug}/`;
const path = `/${category.slug}/${service.slug}/`;
---

<Layout
  title={`${service.name} | ${business.address.city}, ${business.address.stateAbbr}`}
  description={service.excerpt}
>
  <ServiceSchema
    slot="head"
    name={service.name}
    description={service.excerpt}
    path={path}
    category={category.name}
  />

  <PageHero title={service.name} description={service.excerpt} />

  <Breadcrumb
    crumbs={[
      { name: "Home", href: "/" },
      { name: category.name, href: categoryPath },
      { name: service.name, href: path },
    ]}
  />

  <!-- Description -->
  <Section padding="compact">
    <div class="max-w-3xl mx-auto">
      <Text variant="paragraph">{service.description}</Text>
      <Text variant="base" color="muted" className="mt-6">
        Part of our{" "}
        <a href={categoryPath} class="text-primary-600 hover:text-primary-700 font-semibold">{category.name}</a>
        {" "}services.
      </Text>
    </div>
  </Section>

  <!-- FAQ (required on service pages) -->
  <FAQSection faqs={service.faqs} />

  <!-- CTA -->
  <section class="relative py-24 md:py-32 px-4">
    <Image
      src={imgCta}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      quality={50}
    />
    <div class="absolute inset-0 bg-primary-dark/85"></div>
    <div class="relative max-w-3xl mx-auto text-center">
      <SectionTitle
        title="Ready to Get Started?"
        description={`Contact us today for a free quote on ${service.name.toLowerCase()}. We respond within the business day.`}
        color="white"
        lineColor="white"
        className="mb-8"
      />
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href={`tel:${business.phone}`} variant="outline-white">{business.phoneFormatted}</Button>
        <Button href="/contact/" variant="secondary">Free Quote</Button>
      </div>
    </div>
  </section>
</Layout>
