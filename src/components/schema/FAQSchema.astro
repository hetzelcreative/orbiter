---
import type { FAQ } from '../../data/services';

interface Props {
  faqs: FAQ[];
}

const { faqs } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

{faqs.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
