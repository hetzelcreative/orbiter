---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'outline-white';
  size?: 'default' | 'small' | 'large';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  className?: string;
}

const {
  variant = 'primary',
  size = 'default',
  href,
  type = 'button',
  className = '',
} = Astro.props;

const baseStyles =
  'inline-flex items-center justify-center gap-2.5 rounded-lg font-heading font-semibold uppercase tracking-wide transition-all duration-200 cursor-pointer';

const variants: Record<string, string> = {
  primary: 'bg-secondary-500 text-white hover:bg-secondary-600',
  secondary: 'bg-secondary-500 text-white hover:bg-secondary-600',
  outline: 'bg-transparent text-gray-900 border-2 border-gray-900 hover:bg-gray-900 hover:text-white',
  'outline-white': 'bg-transparent text-white border-2 border-white hover:bg-white hover:text-gray-900',
};

const sizes: Record<string, string> = {
  small: 'px-5 py-2.5 text-sm',
  default: 'px-8 py-4 text-base',
  large: 'px-10 py-5 text-lg',
};

const classes = `${baseStyles} ${variants[variant]} ${sizes[size]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
