---
interface Props {
  title: string;
  description?: string;
  align?: 'left' | 'center';
  color?: 'dark' | 'white';
  line?: boolean;
  lineColor?: 'primary' | 'secondary' | 'white';
  className?: string;
}

const {
  title,
  description,
  align = 'center',
  color = 'dark',
  line = true,
  lineColor = 'primary',
  className = '',
} = Astro.props;

const alignClass = align === 'center' ? 'text-center' : 'text-left';
const titleColor = color === 'white' ? 'text-white' : 'text-gray-900';
const descColor = color === 'white' ? 'text-white/80' : 'text-gray-500';
const lineColors: Record<string, string> = {
  primary: 'bg-primary-600',
  secondary: 'bg-secondary-500',
  white: 'bg-white',
};
const lineAlignClass = align === 'center' ? 'mx-auto' : '';
---

<div class:list={[alignClass, className]}>
  <h2 class:list={["text-3xl sm:text-4xl md:text-5xl font-bold leading-tight font-heading", titleColor]}>
    {title}
  </h2>
  {line && (
    <div class:list={["w-16 h-1.5 rounded-full mt-4", lineColors[lineColor], lineAlignClass]} />
  )}
  {description && (
    <p class:list={["text-base md:text-lg leading-relaxed mt-4 max-w-2xl", descColor, align === 'center' ? 'mx-auto' : '']}>
      {description}
    </p>
  )}
</div>
