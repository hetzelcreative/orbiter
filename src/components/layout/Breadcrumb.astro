---
import BreadcrumbSchema from '../schema/BreadcrumbSchema.astro';
import type { Crumb } from '../schema/BreadcrumbSchema.astro';

/**
 * Visible breadcrumb + BreadcrumbList JSON-LD. Used on service pages
 * (Home › Category › Service) and category hubs (Home › Category).
 */
interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-4 py-4">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
    {crumbs.map((crumb, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && (
          <span class="text-gray-300" aria-hidden="true">/</span>
        )}
        {i < crumbs.length - 1 ? (
          <a href={crumb.href} class="hover:text-primary-600 transition-colors">{crumb.name}</a>
        ) : (
          <span class="text-gray-700 font-medium" aria-current="page">{crumb.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<BreadcrumbSchema crumbs={crumbs} />
