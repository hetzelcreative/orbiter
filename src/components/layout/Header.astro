---
import { business } from '../../data/business';
import { mainNav } from '../../data/navigation';
import PriorityNav from './PriorityNav.astro';
import { MobileMenu } from './MobileMenu';
import Button from '../ui/Button.astro';

const currentPath = Astro.url.pathname;
---

<!-- Top info bar -->
<div class="bg-primary-dark text-white text-sm hidden md:block">
  <div class="max-w-7xl mx-auto px-6 py-2 flex items-center justify-between">
    <div class="flex items-center gap-8">
      <!-- Service Area -->
      <span class="flex items-center gap-2 text-white">
        <svg class="size-4 text-primary-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" />
        </svg>
        {business.address.street}, {business.address.city}, {business.address.stateAbbr} {business.address.zip}
      </span>
      <!-- Hours -->
      <span class="flex items-center gap-2 text-white">
        <svg class="size-4 text-primary-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" />
          <polyline points="12 6 12 12 16 14" />
        </svg>
        Mon-Fri 9AM - 5PM
      </span>
      <!-- Social Links -->
      <div class="flex items-center gap-2">
        {business.socialProfiles.facebook && (
          <a href={business.socialProfiles.facebook} target="_blank" rel="noopener noreferrer" class="text-white hover:text-white/80 transition-colors" aria-label="Facebook">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg>
          </a>
        )}
        {business.socialProfiles.instagram && (
          <a href={business.socialProfiles.instagram} target="_blank" rel="noopener noreferrer" class="text-white hover:text-white/80 transition-colors" aria-label="Instagram">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" x2="17.51" y1="6.5" y2="6.5" /></svg>
          </a>
        )}
      </div>
    </div>
    <!-- Google Rating -->
    <div class="flex items-center gap-2 text-white">
      <div class="flex items-center gap-0.5">
        <svg class="size-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
        <svg class="size-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
        <svg class="size-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
        <svg class="size-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
        <svg class="size-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
      </div>
      <!-- Google "G" icon -->
      <svg class="size-5" viewBox="0 0 24 24" fill="none">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4" />
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05" />
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
      </svg>
      <span class="font-semibold">{business.googleReviewRating} Rating</span>
    </div>
  </div>
</div>

<!-- Main header: Logo + Nav + Phone/CTA -->
<header class="bg-white text-gray-900 sticky top-0 z-50 shadow-sm">
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="shrink-0 py-3">
      <img src="/logo.png" alt={business.name} class="h-[100px] w-auto" />
    </a>

    <!-- Center: Nav (desktop) -->
    <div class="hidden md:flex flex-1 justify-center px-8">
      <PriorityNav navItems={mainNav} currentPath={currentPath} />
    </div>

    <!-- Right: Phone + CTA (desktop) -->
    <div class="hidden md:flex items-center gap-6 shrink-0">
      <a
        href={`tel:${business.phone}`}
        class="text-2xl font-bold text-gray-900 hover:text-gray-900 transition-colors"
      >
        {business.phoneFormatted}
      </a>
      <Button href="/contact/">Free Quote</Button>
    </div>

    <!-- Mobile: Full-screen menu -->
    <MobileMenu
      navItems={mainNav}
      phone={business.phone}
      phoneFormatted={business.phoneFormatted}
      ctaLabel="Free Quote"
      ctaHref="/contact/"
      currentPath={currentPath}
      client:load
    />
  </div>
</header>
