# Twilio SMS notifications for form submissions (netlify/functions/send-sms.js).
# Copy to .env for local dev; set the real values in the Netlify dashboard for production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio-owned "from" number, e.g. +15555551234
TWILIO_PHONE_NUMBER=
# Where the business owner wants form alerts sent, e.g. +14025551234
RECIPIENT_PHONE_NUMBER=

# Google reviews via DataForSEO (scripts/fetch-reviews.js, runs on build).
# Sign up at https://dataforseo.com. Leave blank to skip the fetch and keep
# the committed src/data/reviews.json.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# The business's Google Place ID:
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=

# Email notifications for form submissions (Resend). Sent from the agency's
# verified subdomain so client addresses work (Netlify's built-in email
# notifications only allow team members). One sending-only key per site.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=owner@client.com
# NOTIFY_EMAIL_FROM=Client Business Name Website <notifications@forms.hetzelcreative.com>
# NOTIFY_SITE_NAME=Client Business Name
